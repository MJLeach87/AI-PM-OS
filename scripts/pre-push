#!/usr/bin/env bash
# PM OS Pre-Push Gate
# Runs automatically on every `git push` after install:
#   cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# Blocks push on: committed secrets, merge conflict markers, junk files.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

PASS=0
FAIL=0

fail() {
  echo -e "${RED}[BLOCKED]${NC} $1"
  FAIL=$((FAIL + 1))
}

warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

ok() {
  echo -e "${GREEN}[OK]${NC} $1"
}

echo ""
echo "=== PM OS Pre-Push Gate ==="
echo ""

# ─── SECURITY CHECKS (blocking) ────────────────────────────────────────────

# 1. .env tracked in git
if git ls-files --error-unmatch .env 2>/dev/null; then
  fail ".env is tracked by git — remove with: git rm --cached .env"
else
  ok ".env not tracked"
fi

# 2. Secret patterns in tracked files
# Patterns require the value (after =) to not start with < or [ — this prevents
# false positives on placeholder values like KEY=<your-value> or KEY=[placeholder].
# sk- requires 20+ chars to avoid matching common words like "risk-based" or "task-repo".
# scripts/pre-push is self-excluded (it contains these pattern strings as shell variables).
SECRET_PATTERNS='API_KEY=[^<\[]|SECRET=[^<\[]|PASSWORD=[^<\[]|ghp_[A-Za-z0-9]+|sk-[A-Za-z0-9]{20,}|AKIA[A-Z0-9]+'
if git ls-files -z | xargs -0 grep -El "$SECRET_PATTERNS" 2>/dev/null | grep -qvE '^(\.env|scripts/pre-push)$'; then
  MATCHES=$(git ls-files -z | xargs -0 grep -El "$SECRET_PATTERNS" 2>/dev/null | grep -vE '^(\.env|scripts/pre-push)$' || true)
  fail "Potential secrets found in tracked files:\n$MATCHES"
else
  ok "No secret patterns detected"
fi

# 3. Merge conflict markers
# Exclude this script itself (it contains the conflict pattern as a shell string literal).
CONFLICT_PATTERN='<<<<<<<|>>>>>>>'
if git ls-files -z | xargs -0 grep -El "$CONFLICT_PATTERN" 2>/dev/null | grep -qvE '^scripts/pre-push$'; then
  CONFLICTS=$(git ls-files -z | xargs -0 grep -El "$CONFLICT_PATTERN" 2>/dev/null | grep -vE '^scripts/pre-push$' || true)
  fail "Merge conflict markers found in:\n$CONFLICTS"
else
  ok "No merge conflict markers"
fi

# ─── GIT HYGIENE CHECKS (blocking) ─────────────────────────────────────────

# 4. Junk files tracked
JUNK_FILES=$(git ls-files -- "*.tmp" "*.log" "nul" "test_*.js" 2>/dev/null || true)
if [ -n "$JUNK_FILES" ]; then
  fail "Junk files tracked by git:\n$JUNK_FILES"
else
  ok "No junk files tracked"
fi

# ─── DOCUMENTATION CURRENCY CHECKS (warning only) ──────────────────────────

# 5. Skill–README drift
# Every directory under .claude/skills/ should appear in README.md.
# This catches "new skill added but README not updated" before push.
# Warning only — README update may be a follow-on commit.
SKILL_DIRS=$(git ls-files '.claude/skills/' | grep '/SKILL\.md$' | sed 's|\.claude/skills/||;s|/SKILL\.md||' | sort)
MISSING_README=""
for skill in $SKILL_DIRS; do
  if ! grep -q "$skill" README.md 2>/dev/null; then
    MISSING_README="$MISSING_README\n  - $skill"
  fi
done
if [ -n "$MISSING_README" ]; then
  warn "Skills not mentioned in README.md — run /pm-os-doc-sync to update:$MISSING_README"
else
  ok "All skills referenced in README.md"
fi

# 6. Skill–CLAUDE.md routing drift
# Every skill directory should also appear in the CLAUDE.md routing table.
MISSING_CLAUDE=""
for skill in $SKILL_DIRS; do
  if ! grep -q "$skill" .claude/CLAUDE.md 2>/dev/null; then
    MISSING_CLAUDE="$MISSING_CLAUDE\n  - $skill"
  fi
done
if [ -n "$MISSING_CLAUDE" ]; then
  warn "Skills not mentioned in .claude/CLAUDE.md — run /pm-os-doc-sync to update:$MISSING_CLAUDE"
else
  ok "All skills referenced in CLAUDE.md"
fi

# ─── RESULT ────────────────────────────────────────────────────────────────

echo ""
if [ "$FAIL" -gt 0 ]; then
  echo -e "${RED}Push blocked — $FAIL check(s) failed. Fix the issues above and retry.${NC}"
  echo -e "For deeper review after fixing: run ${YELLOW}/release-check${NC} in Claude Code."
  echo ""
  exit 1
else
  echo -e "${GREEN}All checks passed. Pushing...${NC}"
  echo ""
  exit 0
fi
